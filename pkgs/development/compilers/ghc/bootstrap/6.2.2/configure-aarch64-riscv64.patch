aarch64 and riscv64 Linux entries in configure's platform table, which
predates both and otherwise stops with "Unrecognised platform".  They are the
x86_64-*-linux* entry with the architecture changed.  configure is patched
after configure.ac, so that make does not try to regenerate it.

--- a/configure.ac
+++ b/configure.ac
@@ -233,6 +233,24 @@
         HostVendor_CPP='unknown'
         HostOS_CPP='linux'
 	;;
+aarch64-*-linux*)
+        HostPlatform=aarch64-unknown-linux
+        TargetPlatform=aarch64-unknown-linux
+        BuildPlatform=aarch64-unknown-linux
+        HostPlatform_CPP='aarch64_unknown_linux'
+        HostArch_CPP='aarch64'
+        HostVendor_CPP='unknown'
+        HostOS_CPP='linux'
+        ;;
+riscv64-*-linux*)
+        HostPlatform=riscv64-unknown-linux
+        TargetPlatform=riscv64-unknown-linux
+        BuildPlatform=riscv64-unknown-linux
+        HostPlatform_CPP='riscv64_unknown_linux'
+        HostArch_CPP='riscv64'
+        HostVendor_CPP='unknown'
+        HostOS_CPP='linux'
+        ;;
 m68k-*-linux*)
         HostPlatform=m68k-unknown-linux # hack again
         TargetPlatform=m68k-unknown-linux                    
--- a/configure
+++ b/configure
@@ -1634,6 +1634,24 @@
         HostVendor_CPP='unknown'
         HostOS_CPP='linux'
 	;;
+aarch64-*-linux*)
+        HostPlatform=aarch64-unknown-linux
+        TargetPlatform=aarch64-unknown-linux
